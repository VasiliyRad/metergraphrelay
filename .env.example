OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # optional; only needed for self-hosted Langfuse
BRAINTRUST_API_KEY=your-braintrust-key-here
# BRAINTRUST_BASE_URL=https://api.braintrust.dev  # optional; EU is https://api-eu.braintrust.dev, or a self-hosted data plane URL
METERGRAPH_APP_TOKEN=your-metergraph-token-here
# Portkey API cron mode (metergraphrelay sync portkey with no export file):
PORTKEY_API_KEY=pk-your-portkey-key-here
# PORTKEY_WORKSPACE=ws-your-workspace-id   # or pass --source-scope; the stable workspace id, not a secret
# PORTKEY_BASE_URL=https://api.portkey.ai/v1  # optional; override the Portkey API base URL (include the /v1 API-version prefix)
